<Window x:Class="DeskFolder.Views.ExpandArrangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="展开图标显示排列" Width="260" Height="190"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
            <TextBlock Text="行：" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <TextBox x:Name="RowsBox" Width="56" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="列：" VerticalAlignment="Center" FontSize="14" Margin="20,0,8,0"/>
            <TextBox x:Name="ColsBox" Width="56" Height="26" VerticalContentAlignment="Center"/>
        </StackPanel>
        <CheckBox x:Name="UseGlobalCheck" Content="跟随全局设置" Margin="0,0,0,14"
                  Checked="UseGlobal_CheckChanged" Unchecked="UseGlobal_CheckChanged"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="72" Height="28" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="72" Height="28" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
