<Window x:Class="DeskFolder.Views.EdgeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴边设置" Width="300" Height="360"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="贴边位置" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="AnchorCombo" Height="28" SelectedIndex="1"
                  SelectionChanged="AnchorCombo_SelectionChanged">
            <ComboBoxItem Content="顶边（屏幕上方）"/>
            <ComboBoxItem Content="左边（屏幕左侧）"/>
            <ComboBoxItem Content="右边（屏幕右侧）"/>
        </ComboBox>

        <TextBlock Text="方框透明度" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <StackPanel Orientation="Horizontal">
            <Slider x:Name="OpacitySlider" Width="170" Minimum="0" Maximum="1" TickFrequency="0.01"
                    IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged"/>
            <TextBlock x:Name="OpacityText" Width="48" Text="28%" VerticalAlignment="Center"
                       Margin="8,0,0,0" FontSize="13"/>
        </StackPanel>

        <TextBlock Text="方框大小（像素）" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="宽：" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
            <TextBox x:Name="WidthBox" Width="56" Height="26" VerticalContentAlignment="Center"
                     TextChanged="SizeBox_TextChanged"/>
            <TextBlock Text="高：" VerticalAlignment="Center" FontSize="13" Margin="16,0,6,0"/>
            <TextBox x:Name="HeightBox" Width="56" Height="26" VerticalContentAlignment="Center"
                     TextChanged="SizeBox_TextChanged"/>
        </StackPanel>

        <TextBlock Text="远离屏幕的圆角（像素）" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <StackPanel Orientation="Horizontal">
            <Slider x:Name="CornerSlider" Width="170" Minimum="0" Maximum="40" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="CornerSlider_ValueChanged"/>
            <TextBlock x:Name="CornerText" Width="48" Text="8" VerticalAlignment="Center"
                       Margin="8,0,0,0" FontSize="13"/>
        </StackPanel>

        <TextBlock Text="展开时距屏幕边缘距离（像素）" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <TextBox x:Name="DistanceBox" Width="80" Height="26" HorizontalAlignment="Left"
                 VerticalContentAlignment="Center" TextChanged="DistanceBox_TextChanged"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="确定" Width="72" Height="28" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="72" Height="28" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
