<Window x:Class="DeskFolder.Views.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主题设置" Width="400" Height="680"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Background="#F5F5F5">
        <DockPanel Margin="0,0,0,0">

            <!-- 自定义标题栏 -->
            <Grid DockPanel.Dock="Top" Height="48" Margin="20,10,8,0">
                <TextBlock Text="主题设置" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Click="CloseBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="14" Foreground="#666"
                               HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="28"/>
                </Button>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                <StackPanel Margin="20,8,20,20">

                    <!-- 主题名称 卡片 -->
                    <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="主题名称" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 主题类型（分段控件）+ 颜色组 合并卡片 -->
                    <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 分段控件：前三种常见类型一行；后六类换行以紧凑形式显示 -->
                            <TextBlock Text="主题类型" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" x:Name="ModeSegment">
                                <Button x:Name="ModeFillBtn" Content="纯色填充" Click="ModeFill_Click"
                                        Padding="14,7" Background="#0078D7" Foreground="White"
                                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                        HorizontalContentAlignment="Center"/>
                                <Button x:Name="ModeBorderBtn" Content="简约方框" Click="ModeBorder_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center" Margin="-1,0,0,0"/>
                                <Button x:Name="ModeImageBtn" Content="图片背景" Click="ModeImage_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center" Margin="-1,0,0,0"/>
                                <Button x:Name="ModeGradientBtn" Content="渐变" Click="ModeGradient_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center" Margin="-1,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" x:Name="ModeSegment2" Margin="0,4,0,0">
                                <Button x:Name="ModeNeonBtn" Content="霓虹" Click="ModeNeon_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center"/>
                                <Button x:Name="ModeGlassBtn" Content="玻璃" Click="ModeGlass_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center" Margin="-1,0,0,0"/>
                                <Button x:Name="ModeAcrylicBtn" Content="亚克力" Click="ModeAcrylic_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center" Margin="-1,0,0,0"/>
                                <Button x:Name="ModePaperBtn" Content="折纸" Click="ModePaper_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center" Margin="-1,0,0,0"/>
                                <Button x:Name="ModeEmbossBtn" Content="浮雕" Click="ModeEmboss_Click"
                                        Padding="14,7" Background="#F0F0F0" Foreground="#444"
                                        BorderThickness="0" FontSize="12"
                                        HorizontalContentAlignment="Center" Margin="-1,0,0,0"/>
                            </StackPanel>

                            <!-- 隐藏的 ComboBox（保留供代码-behind通过 SelectedIndex 读取/设置） -->
                            <ComboBox x:Name="ModeCombo" Visibility="Collapsed" SelectionChanged="ModeCombo_SelectionChanged">
                                <ComboBoxItem Content="填充颜色"/>
                                <ComboBoxItem Content="简约方框"/>
                                <ComboBoxItem Content="图片背景"/>
                                <ComboBoxItem Content="渐变"/>
                                <ComboBoxItem Content="霓虹"/>
                                <ComboBoxItem Content="玻璃"/>
                                <ComboBoxItem Content="亚克力"/>
                                <ComboBoxItem Content="折纸"/>
                                <ComboBoxItem Content="浮雕"/>
                            </ComboBox>

                            <!-- 颜色组（填充背景 / 方框颜色） -->
                            <StackPanel x:Name="ColorGroup" Margin="0,14,0,0">
                                <TextBlock x:Name="ColorLabel" Text="背景颜色" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <!-- 大色块预览 + 十六进制值同行 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 色块预览（圆角矩形） -->
                                    <Border Grid.Column="0" x:Name="ColorPreview" CornerRadius="10"
                                            Width="80" Height="56" BorderBrush="#DDD" BorderThickness="1"/>
                                    <!-- 十六进制值显示 -->
                                    <TextBox Grid.Column="1" x:Name="HexBox" TextChanged="HexBox_TextChanged"
                                             VerticalContentAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                             Foreground="#0078D7" Margin="12,0,0,0"
                                             ToolTip="十六进制颜色，可手动输入"/>
                                </Grid>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="色相 H" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="HVal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                                </Grid>
                                <Slider x:Name="HueSlider" Minimum="0" Maximum="360" TickFrequency="1" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="饱和度 S" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="SVal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                                </Grid>
                                <Slider x:Name="SatSlider" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="明度 V" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="VVal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                                </Grid>
                                <Slider x:Name="ValSlider" Minimum="0" Maximum="100" TickFrequency="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 透明度组 卡片 -->
                    <Border x:Name="OpacityCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel x:Name="OpacityGroup">
                            <TextBlock x:Name="OpacityLabel" Text="背景透明度" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="1"/>
                                <TextBlock x:Name="OpacityVal" Grid.Column="1" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 方框组 卡片（简约方框模式） -->
                    <Border x:Name="BorderCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel x:Name="BorderGroup">
                            <TextBlock Text="方框宽度" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BorderWidthSlider" Grid.Column="0" Minimum="1" Maximum="20" TickFrequency="1"/>
                                <TextBlock x:Name="BorderWidthVal" Grid.Column="1" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <TextBlock Text="方框类型" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="BorderStyleCombo" SelectionChanged="BorderStyleCombo_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 图片组 卡片（图片背景模式） -->
                    <Border x:Name="ImageCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel x:Name="ImageGroup">
                            <TextBlock Text="图片背景模式" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="SingleModeRadio" Content="单图模式" GroupName="ImgLayout"
                                             Checked="ImgLayout_Changed" Margin="0,0,18,0"/>
                                <RadioButton x:Name="MultiModeRadio" Content="多图模式" GroupName="ImgLayout"
                                             Checked="ImgLayout_Changed"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8">
                                单图模式：折叠与展开共用同一组图片（轮播/随机时同步显示同一张）。多图模式：折叠与展开各自一组图片，可分别设置。
                            </TextBlock>

                            <!-- 缩略图预览（透明棋盘格底） -->
                            <Grid Width="200" Height="110" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Grid.Background>
                                    <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,16,16">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#E6E6E6" Geometry="M0,0 H8 V8 H0 Z"/>
                                                <GeometryDrawing Brush="#E6E6E6" Geometry="M8,8 H16 V16 H8 Z"/>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.Background>
                                <Image x:Name="ImageThumb" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 单图模式面板 -->
                            <StackPanel x:Name="SinglePanel" Margin="0,0,0,8">
                                <Button x:Name="SingleImportBtn" Content="导入图片…（可多选）" Click="SingleImport_Click"
                                        Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="SingleList" Margin="0,0,0,6"/>
                                <TextBlock Text="播放方式" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                                <ComboBox x:Name="SinglePlayCombo" SelectionChanged="SinglePlay_Changed" Margin="0,0,0,6">
                                    <ComboBoxItem Content="不轮播"/>
                                    <ComboBoxItem Content="轮流播放"/>
                                    <ComboBoxItem Content="随机播放"/>
                                </ComboBox>
                                <TextBlock Text="切换间隔" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                                <ComboBox x:Name="SingleIntervalCombo" SelectionChanged="SingleInterval_Changed" Margin="0,0,0,6">
                                    <ComboBoxItem Content="1 分钟"/>
                                    <ComboBoxItem Content="3 分钟"/>
                                    <ComboBoxItem Content="5 分钟"/>
                                    <ComboBoxItem Content="10 分钟"/>
                                    <ComboBoxItem Content="15 分钟"/>
                                    <ComboBoxItem Content="30 分钟"/>
                                    <ComboBoxItem Content="60 分钟"/>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="CropImageBtn" Content="裁剪图片…" Click="CropImage_Click"
                                            Padding="10,5" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearCropBtn" Content="清除裁剪" Click="ClearCrop_Click"
                                            Padding="10,5"/>
                                </StackPanel>
                                <TextBlock x:Name="CropStatusText" FontSize="11" Foreground="#0078D7"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Text="未裁剪（显示整图）"/>
                            </StackPanel>

                            <!-- 多图模式面板 -->
                            <StackPanel x:Name="MultiPanel" Visibility="Collapsed">
                                <!-- 折叠态 -->
                                <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="折叠态图片" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Button Content="导入图片…（可多选）" Click="CollapsedImport_Click" Padding="8,4"
                                                HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                        <WrapPanel x:Name="CollapsedList" Margin="0,0,0,6"/>
                                        <TextBlock Text="播放方式" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CollapsedPlayCombo" SelectionChanged="CollapsedPlay_Changed" Margin="0,0,0,6">
                                            <ComboBoxItem Content="不轮播"/>
                                            <ComboBoxItem Content="轮流播放"/>
                                            <ComboBoxItem Content="随机播放"/>
                                        </ComboBox>
                                        <TextBlock Text="切换间隔" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CollapsedIntervalCombo" SelectionChanged="CollapsedInterval_Changed" Margin="0,0,0,6">
                                            <ComboBoxItem Content="1 分钟"/><ComboBoxItem Content="3 分钟"/><ComboBoxItem Content="5 分钟"/>
                                            <ComboBoxItem Content="10 分钟"/><ComboBoxItem Content="15 分钟"/>
                                            <ComboBoxItem Content="30 分钟"/><ComboBoxItem Content="60 分钟"/>
                                        </ComboBox>
                                        <Button Content="裁剪折叠态图片…" Click="CropCollapsed_Click" Padding="8,4" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <!-- 展开态 -->
                                <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="展开态图片" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Button Content="导入图片…（可多选）" Click="ExpandedImport_Click" Padding="8,4"
                                                HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                        <WrapPanel x:Name="ExpandedList" Margin="0,0,0,6"/>
                                        <TextBlock Text="播放方式" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="ExpandedPlayCombo" SelectionChanged="ExpandedPlay_Changed" Margin="0,0,0,6">
                                            <ComboBoxItem Content="不轮播"/>
                                            <ComboBoxItem Content="轮流播放"/>
                                            <ComboBoxItem Content="随机播放"/>
                                        </ComboBox>
                                        <TextBlock Text="切换间隔" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="ExpandedIntervalCombo" SelectionChanged="ExpandedInterval_Changed" Margin="0,0,0,6">
                                            <ComboBoxItem Content="1 分钟"/><ComboBoxItem Content="3 分钟"/><ComboBoxItem Content="5 分钟"/>
                                            <ComboBoxItem Content="10 分钟"/><ComboBoxItem Content="15 分钟"/>
                                            <ComboBoxItem Content="30 分钟"/><ComboBoxItem Content="60 分钟"/>
                                        </ComboBox>
                                        <Button Content="裁剪展开态图片…" Click="CropExpanded_Click" Padding="8,4" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <CheckBox x:Name="HideIconCollapsedCheck" Content="折叠态隐藏图标（仅显示图片背景）" Margin="0,10,0,0"
                                      Checked="HideIconCollapsed_Changed" Unchecked="HideIconCollapsed_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 圆角组 卡片 -->
                    <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel x:Name="RadiusGroup">
                            <TextBlock Text="应用文件夹圆角大小" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RadiusSlider" Grid.Column="0" Minimum="0" Maximum="40" TickFrequency="1"/>
                                <TextBlock x:Name="RadiusVal" Grid.Column="1" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 渐变参数 卡片 -->
                    <Border x:Name="GradientCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="渐变参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <!-- 渐变双色 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="起始色 A" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                    <Border x:Name="GradientColorAPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                            MouseLeftButtonDown="GradientColorA_Click" Cursor="Hand" ToolTip="点击选择颜色"/>
                                    <TextBox x:Name="GradientColorABox" TextChanged="GradientColorA_TextChanged"
                                             Margin="0,4,8,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="结束色 B" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                    <Border x:Name="GradientColorBPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                            MouseLeftButtonDown="GradientColorB_Click" Cursor="Hand" ToolTip="点击选择颜色"/>
                                    <TextBox x:Name="GradientColorBBox" TextChanged="GradientColorB_TextChanged"
                                             Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="渐变方向" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                            <ComboBox x:Name="GradientTypeCombo" SelectionChanged="GradientTypeCombo_Changed" Margin="0,0,0,6">
                                <ComboBoxItem Content="线性（可调角度）"/>
                                <ComboBoxItem Content="径向（中心扩散）"/>
                                <ComboBoxItem Content="对角（左上→右下）"/>
                                <ComboBoxItem Content="垂直（上→下）"/>
                                <ComboBoxItem Content="水平（左→右）"/>
                            </ComboBox>
                            <Grid x:Name="GradientAngleRow" Margin="0,0,0,2">
                                <TextBlock Text="线性角度" FontSize="12"/>
                                <TextBlock x:Name="GradientAngleVal" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="GradientAngleSlider" Minimum="0" Maximum="360" TickFrequency="1" Margin="0,0,0,10"
                                    ValueChanged="GradientAngleSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 霓虹风格 卡片 -->
                    <Border x:Name="NeonCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="霓虹风格参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="发光颜色" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                    <Border x:Name="NeonGlowPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                            MouseLeftButtonDown="NeonGlow_Click" Cursor="Hand"/>
                                    <TextBox x:Name="NeonGlowBox" TextChanged="NeonGlow_TextChanged"
                                             Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="背景色（深色）" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                    <Border x:Name="NeonBgPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                            MouseLeftButtonDown="NeonBg_Click" Cursor="Hand"/>
                                    <TextBox x:Name="NeonBgBox" TextChanged="NeonBg_TextChanged"
                                             Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="发光强度" FontSize="12"/>
                                <TextBlock x:Name="NeonGlowIntensityVal" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="NeonGlowIntensitySlider" Minimum="0" Maximum="3" TickFrequency="0.1"
                                    ValueChanged="NeonGlowIntensity_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 玻璃拟态 卡片 -->
                    <Border x:Name="GlassCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="玻璃拟态参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="玻璃主色" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                    <Border x:Name="GlassTintPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                            MouseLeftButtonDown="GlassTint_Click" Cursor="Hand"/>
                                    <TextBox x:Name="GlassTintBox" TextChanged="GlassTint_TextChanged"
                                             Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="高光边颜色" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                    <Border x:Name="GlassHlPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                            MouseLeftButtonDown="GlassHl_Click" Cursor="Hand"/>
                                    <TextBox x:Name="GlassHlBox" TextChanged="GlassHl_TextChanged"
                                             Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="玻璃饱和度（0=磨砂 / 1=纯玻璃）" FontSize="12"/>
                                <TextBlock x:Name="GlassSatVal" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="GlassSatSlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    ValueChanged="GlassSat_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 亚克力 / Mica 卡片 -->
                    <Border x:Name="AcrylicCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="亚克力（Mica Alt）参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="亚克力叠色" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                <Border x:Name="AcrylicTintPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                        MouseLeftButtonDown="AcrylicTint_Click" Cursor="Hand"/>
                                <TextBox x:Name="AcrylicTintBox" TextChanged="AcrylicTint_TextChanged"
                                         Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="叠层透明度" FontSize="12"/>
                                <TextBlock x:Name="AcrylicOpacityVal" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="AcrylicOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    ValueChanged="AcrylicOpacity_ValueChanged" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="噪点层不透明度（颗粒感）" FontSize="12"/>
                                <TextBlock x:Name="AcrylicNoiseVal" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="AcrylicNoiseSlider" Minimum="0" Maximum="0.3" TickFrequency="0.01"
                                    ValueChanged="AcrylicNoise_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 折纸风格 卡片 -->
                    <Border x:Name="PaperCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="折纸风格参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="纸张颜色" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                <Border x:Name="PaperColorPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                        MouseLeftButtonDown="PaperColor_Click" Cursor="Hand"/>
                                <TextBox x:Name="PaperColorBox" TextChanged="PaperColor_TextChanged"
                                         Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="折痕方向" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                            <ComboBox x:Name="PaperFoldCombo" SelectionChanged="PaperFoldCombo_Changed" Margin="0,0,0,10">
                                <ComboBoxItem Content="左上折"/>
                                <ComboBoxItem Content="右上折"/>
                                <ComboBoxItem Content="左下折"/>
                                <ComboBoxItem Content="右下折"/>
                            </ComboBox>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="折痕阴影深度" FontSize="12"/>
                                <TextBlock x:Name="PaperShadowVal" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="PaperShadowSlider" Minimum="0" Maximum="2" TickFrequency="0.1"
                                    ValueChanged="PaperShadow_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 浮雕风格 卡片 -->
                    <Border x:Name="EmbossCard" CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="浮雕风格参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="浮雕底色" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                <Border x:Name="EmbossColorPreview" CornerRadius="6" Height="36" BorderBrush="#DDD" BorderThickness="1"
                                        MouseLeftButtonDown="EmbossColor_Click" Cursor="Hand"/>
                                <TextBox x:Name="EmbossColorBox" TextChanged="EmbossColor_TextChanged"
                                         Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="凸起高度（立体感）" FontSize="12"/>
                                <TextBlock x:Name="EmbossHeightVal" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="EmbossHeightSlider" Minimum="0" Maximum="8" TickFrequency="0.5"
                                    ValueChanged="EmbossHeight_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 文字设置组 卡片 -->
                    <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel x:Name="TextGroup">
                            <TextBlock Text="文字设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="字体" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <ComboBox x:Name="FontCombo" Margin="0,0,0,0" SelectionChanged="FontCombo_SelectionChanged"
                                          HorizontalAlignment="Right" MinWidth="140"/>
                            </Grid>

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="文字大小" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="TextSizeVal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="#0078D7" FontSize="13"/>
                            </Grid>
                            <Slider x:Name="TextSizeSlider" Minimum="0" Maximum="48" TickFrequency="1" Margin="0,0,0,10"/>

                            <CheckBox x:Name="TextColorAuto" Content="自动颜色（跟随背景）" Margin="0,0,0,4"
                                      Checked="TextColorAuto_Changed" Unchecked="TextColorAuto_Changed"/>
                            <StackPanel x:Name="TextColorPanel" Margin="0,0,0,10">
                                <!-- 快速取色 -->
                                <TextBlock Text="快速取色" FontSize="12" Foreground="#555" Margin="0,0,0,3"/>
                                <WrapPanel x:Name="TextQuickColors" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="色相 H" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="TextHVal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#0078D7" FontSize="12"/>
                                </Grid>
                                <Slider x:Name="TextHueSlider" Minimum="0" Maximum="360" TickFrequency="1" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="饱和度 S" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="TextSVal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#0078D7" FontSize="12"/>
                                </Grid>
                                <Slider x:Name="TextSatSlider" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="明度 V" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="TextVVal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#0078D7" FontSize="12"/>
                                </Grid>
                                <Slider x:Name="TextValSlider" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextColorHex" Grid.Column="0" TextChanged="TextColorHex_TextChanged"
                                             VerticalContentAlignment="Center" FontSize="12"
                                             ToolTip="十六进制颜色，如 #FF0000"/>
                                    <Border x:Name="TextColorSwatch" Grid.Column="1" Width="32" Height="28" CornerRadius="5"
                                            BorderBrush="#999" BorderThickness="1" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="文字位置" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TextPosCombo" SelectionChanged="TextPosCombo_SelectionChanged"
                                          HorizontalAlignment="Right" MinWidth="80">
                                    <ComboBoxItem Content="底部"/>
                                    <ComboBoxItem Content="居中"/>
                                    <ComboBoxItem Content="顶部"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="BoldCheck" Content="加粗" Margin="0,0,0,6"
                                      Checked="BoldCheck_Changed" Unchecked="BoldCheck_Changed"/>
                            <CheckBox x:Name="HideCollapsedCheck" Content="折叠状态隐藏文字" Margin="0,0,0,4"
                                      Checked="HideCollapsed_Changed" Unchecked="HideCollapsed_Changed"/>
                            <CheckBox x:Name="HideExpandedCheck" Content="展开状态隐藏文字"
                                      Checked="HideExpanded_Changed" Unchecked="HideExpanded_Changed"/>
                            <CheckBox x:Name="HideShortcutNamesCheck" Content="隐藏软件名称（悬停显示）" Margin="0,4,0,0"
                                      Checked="HideShortcutNames_Changed" Unchecked="HideShortcutNames_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 效果预览 卡片 -->
                    <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="效果预览" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border x:Name="SampleChip" Width="130" Height="96" HorizontalAlignment="Left">
                                <TextBlock x:Name="SampleText" Text="文件夹" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 底部按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button x:Name="DeleteButton" Content="删除主题" Click="Delete_Click"
                                Padding="14,7" Margin="0,0,12,0" Foreground="#C0392B"
                                Background="White" BorderBrush="#E0E0E0" BorderThickness="1"/>
                        <Button Content="完成" Click="Done_Click" Padding="18,7"
                                Background="#0078D7" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
