<Window x:Class="DeskFolder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局设置" Width="440" Height="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" FontFamily="Microsoft YaHei UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <!-- 折叠图标大小 卡片 -->
            <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="18,16" Margin="0,0,0,12">
                <StackPanel x:Name="GlobalSizeSection">
                    <TextBlock Text="折叠图标大小" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="折叠状态下文件夹图标的大小，请在该文件夹上右键选择「折叠图标大小设置」直接拖动缩放；行列排列请在右键菜单的「折叠图标显示排列」中设置。"
                               TextWrapping="Wrap" Foreground="#888" FontSize="12" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- 动画与交互 卡片 -->
            <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="18,16" Margin="0,0,0,12">
                <StackPanel x:Name="AnimSection">
                    <!-- 标题行：左侧标题 + 右侧勾选图标 -->
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="动画与交互" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Width="22" Height="22" CornerRadius="11"
                                Background="#0078D7" VerticalAlignment="Center">
                            <TextBlock Text="✓" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="22"/>
                        </Border>
                    </Grid>

                    <!-- 展开动画时长 -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="展开动画时长 (ms)" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock x:Name="AnimValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="#0078D7" FontSize="14"/>
                    </Grid>
                    <Slider x:Name="AnimSlider" Minimum="80" Maximum="600" TickFrequency="20"
                            IsSnapToTickEnabled="True" Margin="0,0,0,14"/>

                    <!-- 悬停展开延迟 -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="悬停展开延迟 (ms)" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock x:Name="HoverValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="#0078D7" FontSize="14"/>
                    </Grid>
                    <Slider x:Name="HoverSlider" Minimum="0" Maximum="800" TickFrequency="50"
                            IsSnapToTickEnabled="True"/>
                </StackPanel>
            </Border>

            <!-- 主题外观 卡片 -->
            <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="18,16" Margin="0,0,0,12">
                <StackPanel x:Name="ThemeSection">
                    <!-- 标题行 + 画刷图标 -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="主题外观" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Width="22" Height="22" CornerRadius="11"
                                Background="#0078D7" VerticalAlignment="Center">
                            <TextBlock Text="🎨" FontSize="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" LineHeight="22"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ThemeHint" Text="左键点击主题名可实时切换外观；右键点击主题名可详细设置该主题（填充颜色 / 简约方框 / 图片背景，可改颜色、透明度、圆角、方框样式或导入图片背景）。"
                               TextWrapping="Wrap" Foreground="#888" FontSize="12" LineHeight="18" Margin="0,0,0,12"/>

                    <!-- 主题列表（可选行样式） -->
                    <ListBox x:Name="ThemeList"
                             SelectionChanged="ThemeList_SelectionChanged"
                             PreviewMouseRightButtonUp="ThemeList_PreviewMouseRightButtonUp"
                             SelectedValuePath="Id"
                             BorderThickness="0" Background="Transparent"
                             Padding="-6,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1.5"
                                                    BorderBrush="Transparent" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#E8F4FD"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 色块预览 -->
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5"
                                            Background="{Binding PreviewBrush}" BorderBrush="#CCC" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <!-- 主题名称 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <!-- 选中指示器（勾选圆圈） -->
                                    <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9"
                                            BorderBrush="#0078D7" BorderThickness="1.5"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            x:Name="CheckMark">
                                        <Border.Background>
                                            <SolidColorBrush Color="#0078D7"/>
                                        </Border.Background>
                                        <TextBlock Text="✓" Foreground="White" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="18"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="＋ 新建主题" Click="NewTheme_Click"
                            Padding="14,6" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Background="Transparent" BorderBrush="#CCC" BorderThickness="1"
                            FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- 文件夹管理 卡片 -->
            <Border CornerRadius="10" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Padding="18,16" Margin="0,0,0,12">
                <StackPanel x:Name="FolderMgmtSection">
                    <TextBlock Text="文件夹管理" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="把桌面上的 .lnk 快捷方式直接拖到文件夹图标上即可添加；首次启动会自动导入当前桌面全部快捷方式。"
                               TextWrapping="Wrap" Foreground="#888" FontSize="12" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- 底部按钮 -->
            <StackPanel x:Name="BottomButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,4">
                <Button Content="恢复默认" Click="Reset_Click" Padding="18,8" Margin="0,0,12,0"
                        Background="White" BorderBrush="#DDD" BorderThickness="1" FontSize="13"/>
                <Button Content="保存并应用" Click="Save_Click" Padding="18,8"
                        Background="#0078D7" Foreground="White" BorderThickness="0" FontSize="13"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
