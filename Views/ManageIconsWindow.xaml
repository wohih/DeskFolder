<Window x:Class="DeskFolder.Views.ManageIconsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除图标" Width="340" Height="320"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="勾选要删除的图标（仅从本文件夹移除，不影响磁盘上的原文件）："
                   TextWrapping="Wrap" FontSize="12" Foreground="#555555" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="72" Height="28" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="72" Height="28" Click="Cancel_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="IconList"/>
        </ScrollViewer>
    </DockPanel>
</Window>
