<Window x:Class="DeskFolder.Views.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        MinWidth="0" MinHeight="0" MaxWidth="4000" MaxHeight="4000"
        Width="150" Height="150"
        AllowDrop="True"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <ContextMenu x:Key="FolderMenu" Opened="FolderMenu_Opened" Closed="FolderMenu_Closed">
            <MenuItem Header="重命名文件夹…" Click="RenameMenu_Click"/>
            <MenuItem Header="添加图标…" Click="AddIconMenu_Click"/>
            <MenuItem Header="删除图标…" Click="DeleteIconMenu_Click"/>
            <MenuItem Header="展开图标显示排列…" Click="ExpandArrangeMenu_Click"/>
            <MenuItem Header="折叠图标大小设置…" Click="SizeMenu_Click"/>
            <MenuItem Header="折叠图标显示排列…" Click="ArrangeMenu_Click"/>
            <MenuItem Header="外观设置…" Click="AppearanceMenu_Click"/>
            <MenuItem Header="插件管理…" Click="PluginsMenu_Click"/>
            <Separator/>
            <MenuItem Header="删除该文件夹" Tag="Delete" Foreground="#C0392B" Click="DeleteMenu_Click"/>
            <Separator/>
            <MenuItem Header="全局设置…" Click="GlobalSettingsMenu_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- 外边距留给阴影，透明区域不接收鼠标事件，点击可穿透到桌面 -->
    <Grid x:Name="Root">

        <!-- 插件宿主容器：覆盖整个窗口，用于渲染折叠态/展开态的美化插件（时钟/便签/日历等）；Z 序高于内容但不阻挡 hit test -->
        <Grid x:Name="PluginHostCollapsed" Panel.ZIndex="20" Margin="24"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              IsHitTestVisible="False"/>
        <Grid x:Name="PluginHostExpanded" Panel.ZIndex="20" Margin="24"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              IsHitTestVisible="False"/>

        <!-- 窗口级浮层：隐藏软件名称模式下的悬停名称标签（在格子外，不受 Dock 缩放影响、不被滚动区裁剪） -->
        <Canvas x:Name="OverlayLayer" Panel.ZIndex="30" IsHitTestVisible="False"/>

        <!-- 折叠态：安卓风格文件夹图标（≈2×2 桌面图标格，内部 3×3 预览）；左上角锚定，与面板同角生长 -->
        <Grid x:Name="CollapsedView" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24">
                <Border x:Name="FolderChip" CornerRadius="18" Background="#99000000"
                    AllowDrop="True"
                    DragEnter="FolderChip_DragEnter" Drop="FolderChip_Drop"
                    MouseLeftButtonDown="FolderChip_MouseLeftButtonDown"
                    MouseMove="FolderChip_MouseMove"
                    MouseLeftButtonUp="FolderChip_MouseLeftButtonUp">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.30" Color="#40000000"/>
                </Border.Effect>
                <Grid>
                    <Grid x:Name="PreviewGrid" Margin="12,12,12,30"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border x:Name="FolderNameBar" VerticalAlignment="Bottom" Background="Transparent"
                            CornerRadius="0,0,18,18" Padding="0,3">
                        <TextBlock x:Name="FolderNameText" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="130"/>
                    </Border>
                    <!-- 折叠图标右下角拖拽缩放手柄（仅在「折叠图标大小设置」模式下显示） -->
                    <primitives:Thumb x:Name="ResizeThumb" Width="22" Height="22"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Cursor="SizeNWSE" Visibility="Collapsed"
                                      DragDelta="ResizeThumb_DragDelta"
                                      DragCompleted="ResizeThumb_DragCompleted">
                        <primitives:Thumb.Template>
                            <ControlTemplate>
                                <Grid Width="22" Height="22" Background="Transparent">
                                    <Path Data="M0,14 L14,14 L14,0 Z" Fill="#3399FF" Opacity="0.0"/>
                                    <Path Data="M14,4 L14,14 L4,14" Stroke="#3399FF" StrokeThickness="2.5"
                                          StrokeEndLineCap="Round"/>
                                </Grid>
                            </ControlTemplate>
                        </primitives:Thumb.Template>
                    </primitives:Thumb>
                </Grid>
            </Border>
        </Grid>

        <!-- 展开态：应用面板（初始隐藏），浅灰半透明；左上角锚定，从折叠图标处向右下生长 -->
        <Border x:Name="Panel" Visibility="Collapsed" Opacity="0"
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24"
                CornerRadius="16"
                Background="#CC000000"
                AllowDrop="True"
                DragEnter="FolderChip_DragEnter" Drop="FolderChip_Drop"
                MouseDown="Panel_MouseDown"
                MouseMove="FolderChip_MouseMove"
                MouseUp="Panel_MouseUp"
                ContextMenu="{StaticResource FolderMenu}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="#50000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>   <!-- 顶部栏：拖动 + 关闭按钮 +（置顶/居中时）标题 -->
                    <RowDefinition Height="*"/>     <!-- 图标网格 -->
                    <RowDefinition Height="Auto"/>  <!-- 底部标题栏（仅文字位置=底部时显示） -->
                </Grid.RowDefinitions>

                <!-- 顶部栏：标题在"置顶/居中"时位于此，关闭按钮始终在右上 -->
                <Grid Grid.Row="0" x:Name="TopTitleBar" Margin="14,6,8,0">
                    <TextBlock x:Name="PanelTitle" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="#F0F0F0"/>
                    <Button x:Name="CollapseButton" HorizontalAlignment="Right" Width="24" Height="24"
                            Content="×" FontSize="14" Padding="0" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Foreground="#BBBBBB"
                            Click="CollapseButton_Click" ToolTip="收起"/>
                </Grid>

                <!-- 可滚动的图标 + 插件混合网格 -->
                <ScrollViewer Grid.Row="1" x:Name="IconScroller"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Margin="8,0,8,10"
                              AllowDrop="True"
                              DragOver="IconGrid_DragOver"
                              Drop="IconGrid_Drop">
                    <ScrollViewer.Resources>
                        <!-- 与黑色半透明面板适配的细圆角半透明滚动条 -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                                   ViewportSize="{TemplateBinding ViewportSize}"
                                                   Maximum="{TemplateBinding Maximum}"
                                                   Minimum="{TemplateBinding Minimum}"
                                                   Value="{TemplateBinding Value}">
                                                <Track.Thumb>
                                                    <Thumb x:Name="Thumb" Cursor="Hand">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border CornerRadius="4"
                                                                        Background="#55FFFFFF"
                                                                        BorderThickness="0"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Thumb"
                                                        Property="Background" Value="#88FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <Grid x:Name="IconGrid" AllowDrop="True"
                          DragOver="IconGrid_DragOver"
                          Drop="IconGrid_Drop"/>
                </ScrollViewer>

                <!-- 底部标题栏：文字位置=底部时承载 PanelTitle（其余情况隐藏） -->
                <Grid Grid.Row="2" x:Name="BottomTitleBar" Visibility="Collapsed" Margin="14,4,8,8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
