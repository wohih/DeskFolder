<Window x:Class="DeskFolder.Views.ManageIconsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理图标" Width="430" Height="480"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Border CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
        <DockPanel Margin="20,0,20,20">

            <!-- 自定义标题栏 -->
            <Grid DockPanel.Dock="Top" Height="48" Margin="18,10,8,0">
                <TextBlock Text="管理图标" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="14" Foreground="#666"
                               HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="28"/>
                </Button>
            </Grid>

            <!-- 说明文字 -->
            <TextBlock DockPanel.Dock="Top" Text="勾选要删除的图标（仅从本文件夹移除，不影响磁盘上的原文件）："
                       TextWrapping="Wrap" FontSize="13" Foreground="#666" Margin="18,12,8,14"/>

            <!-- 图标列表（卡片包裹） -->
            <Border DockPanel.Dock="Top" CornerRadius="10" BorderBrush="#E8E8E8" BorderThickness="1"
                    Background="#FAFAFA" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="280">
                    <StackPanel x:Name="IconList"/>
                </ScrollViewer>
            </Border>

            <!-- 底部按钮 -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="确定" Width="80" Height="36" Click="Ok_Click" Margin="0,0,12,0"
                        Background="#0078D7" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold"/>
                <Button Content="取消" Width="80" Height="36" Click="Cancel_Click"
                        Background="White" BorderBrush="#CCC" BorderThickness="1"
                        FontSize="13" Foreground="#333"/>
            </StackPanel>

        </DockPanel>
    </Border>
</Window>
