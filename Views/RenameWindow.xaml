<Window x:Class="DeskFolder.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名文件夹" Width="300" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="文件夹名称" FontSize="13" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Height="26" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="72" Height="28" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="72" Height="28" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
