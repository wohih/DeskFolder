<Window x:Class="DeskFolder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观设置" Width="400" Height="540"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Microsoft YaHei UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18">

            <StackPanel x:Name="GlobalSizeSection">
                <TextBlock Text="折叠图标大小" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="折叠状态下文件夹图标的大小，请在该文件夹上右键选择「折叠图标大小设置」直接拖动缩放；其行列排列请在右键菜单的「折叠图标显示排列」中设置。"
                           TextWrapping="Wrap" Foreground="#777" FontSize="12" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="AnimSection">
                <TextBlock Text="动画与交互" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,10"/>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="展开动画时长 (ms)" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AnimValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="#0078D7"/>
                </Grid>
                <Slider x:Name="AnimSlider" Minimum="80" Maximum="600" TickFrequency="20"
                        IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="悬停展开延迟 (ms)" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HoverValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="#0078D7"/>
                </Grid>
                <Slider x:Name="HoverSlider" Minimum="0" Maximum="800" TickFrequency="50"
                        IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="ThemeSection">
                <TextBlock Text="主题" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,4"/>
                <TextBlock x:Name="ThemeHint" Text="左键点击主题名可实时切换外观；右键点击主题名可详细设置该主题（填充颜色 / 简约方框 / 图片背景，可改颜色、透明度、圆角、方框样式或导入图片）。"
                           TextWrapping="Wrap" Foreground="#777" FontSize="12" Margin="0,0,0,8"/>
                <ListBox x:Name="ThemeList"
                         SelectionChanged="ThemeList_SelectionChanged"
                         PreviewMouseRightButtonUp="ThemeList_PreviewMouseRightButtonUp"
                         SelectedValuePath="Id"
                         Height="150" BorderThickness="1" BorderBrush="#DDDDDD">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                                        Background="{Binding PreviewBrush}" BorderBrush="#999" BorderThickness="1"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="＋ 新建主题" Click="NewTheme_Click"
                        Padding="10,5" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel x:Name="FolderMgmtSection">
                <TextBlock Text="文件夹管理" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,8"/>
                <TextBlock Text="把桌面上的 .lnk 快捷方式直接拖到文件夹图标上即可添加；首次启动会自动导入当前桌面全部快捷方式。"
                           TextWrapping="Wrap" Foreground="#777" FontSize="12" Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel x:Name="BottomButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,4">
                <Button Content="恢复默认" Click="Reset_Click" Padding="14,6" Margin="0,0,10,0"/>
                <Button Content="保存并应用" Click="Save_Click" Padding="14,6"
                        Background="#0078D7" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
